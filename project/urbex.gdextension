[configuration]

entry_symbol = "urbex_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "res://bin/liburbex.macos.template_debug.framework"
macos.release = "res://bin/liburbex.macos.template_release.framework"
windows.debug.x86_64 = "res://bin/liburbex.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/liburbex.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/liburbex.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/liburbex.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/liburbex.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/liburbex.linux.template_release.arm64.so"
